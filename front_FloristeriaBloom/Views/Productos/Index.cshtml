@model List<front_FloristeriaBloom.Models.ProductoViewModel>
@{
    Layout = null;
    ViewData["Title"] = "Florería";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />

    <!-- Estilos propios (van después de Bootstrap para poder sobreescribirlo con la paleta rosa/vino) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

    <!-- HEADER -->
    <header class="site-header">
        <div class="header-top d-flex align-items-center justify-content-between">
            <a asp-controller="Productos" asp-action="Index" class="logo">
                🌸 FloristeriaBloom
            </a>

            <nav class="main-nav d-none d-md-flex">
                <a asp-controller="Productos" asp-action="Index">Inicio</a>
                <a asp-controller="Productos" asp-action="Catalogo">Catálogo</a>
                <a href="#">Ocasiones</a>
                <a href="#">Ofertas</a>
                <a href="#">Contáctanos</a>
            </nav>

            <div class="header-icons">
                @if (Context.Session.GetString("Rol") == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Index" title="Panel Admin">
                        <i class="fa-solid fa-gear"></i> Admin
                    </a>
                }
                @if (!string.IsNullOrEmpty(Context.Session.GetString("Token")))
                {
                    <a asp-controller="Perfil" asp-action="Index" title="Mi cuenta"><i class="fa-solid fa-user"></i></a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" title="Mi cuenta"><i class="fa-regular fa-user"></i></a>
                }
                <a asp-controller="Carrito" asp-action="Index" class="cart-icon" title="Carrito">
                    <i class="fa-solid fa-basket-shopping"></i>
                    <span class="cart-count">0</span>
                </a>
            </div>
        </div>
    </header>


    <!-- HERO -->
    <section class="hero">
        <div class="container hero-content">
            <p class="hero-small">FLORES PARA CADA MOMENTO</p>
            <h1>Sorprende con <span>hermosos detalles</span></h1>
            <p>Regala flores, emociones y momentos inolvidables.</p>
            <a asp-controller="Productos" asp-action="Catalogo" class="btn btn-flor">VER CATALOGO</a>
        </div>
    </section>

    <!-- CATEGORÍAS -->
    <section class="categories">
        <div class="section-title">
            <p>DESCUBRE NUESTRAS FLORES</p>
        </div>
    </section>

    <!-- 1. PRODUCTOS EN OFERTA -->
    <section class="products-section">
        <div class="container">
            <div class="section-title">
                <h2>Productos en oferta</h2>
            </div>
            <div class="row g-4">
                @foreach (var p in Model.Take(4))
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="product-card h-100">
                            <div class="product-image-container">
                                <img src="@(string.IsNullOrEmpty(p.ImagenUrl) ? "/imagenes/rosas-rojas.jpg" : p.ImagenUrl)" class="img-fluid" />
                            </div>
                            <h3>@p.Nombre</h3>
                            <p class="product-description">@p.Descripcion</p>
                            <div class="price">
                                <strong>S/ @p.Precio</strong>
                            </div>
                            <button type="button" class="btn buy-button agregar-carrito-btn w-100" data-id="@p.Id">COMPRAR</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- 2. LOS MÁS BUSCADOS -->
    <section class="products-section">
        <div class="container">
            <div class="section-title">
                <p>FLORERÍA EN PERÚ</p>
                <h2>Los más buscados</h2>
            </div>
            <div class="row g-4">
                @foreach (var p in Model.Skip(4).Take(4))
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="product-card h-100">
                            <div class="product-image-container">
                                <img src="@(string.IsNullOrEmpty(p.ImagenUrl) ? "/imagenes/rosas-rojas.jpg" : p.ImagenUrl)" class="img-fluid" />
                            </div>
                            <h3>@p.Nombre</h3>
                            <p class="product-description">@p.Descripcion</p>
                            <div class="price">
                                <strong>S/ @p.Precio</strong>
                            </div>
                            <button type="button" class="btn buy-button agregar-carrito-btn w-100" data-id="@p.Id">COMPRAR</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- 3. LO NUEVO DEL MES -->
    <section class="products-section">
        <div class="container">
            <div class="section-title">
                <p>FLORERÍA EN PERÚ</p>
                <h2>Lo nuevo del mes</h2>
            </div>
            <div class="row g-4">
                @foreach (var p in Model.Skip(8).Take(4))
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="product-card h-100">
                            <div class="product-image-container">
                                <img src="@(string.IsNullOrEmpty(p.ImagenUrl) ? "/imagenes/rosas-rojas.jpg" : p.ImagenUrl)" class="img-fluid" />
                            </div>
                            <h3>@p.Nombre</h3>
                            <p class="product-description">@p.Descripcion</p>
                            <div class="price">
                                <strong>S/ @p.Precio</strong>
                            </div>
                            <button type="button" class="btn buy-button agregar-carrito-btn w-100" data-id="@p.Id">COMPRAR</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- POR QUÉ ELEGIRNOS -->
    <section class="benefits">
        <div class="container">
            <div class="section-title">
                <p>NUESTRO COMPROMISO</p>
                <h2>¿Por qué elegirnos?</h2>
            </div>
            <div class="row text-center g-4">
                <div class="col-6 col-md-3"><span>🌸</span><h3>Flores frescas</h3><p>Seleccionamos flores frescas para cada arreglo.</p></div>
                <div class="col-6 col-md-3"><span>💝</span><h3>Diseños especiales</h3><p>Creamos detalles pensados para cada ocasión.</p></div>
                <div class="col-6 col-md-3"><span>🚚</span><h3>Delivery</h3><p>Llevamos tus flores hasta la puerta de tu casa.</p></div>
                <div class="col-6 col-md-3"><span>💐</span><h3>Calidad</h3><p>Trabajamos para ofrecerte productos de calidad.</p></div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta">
        <h2>Haz que alguien sonría hoy 🌷</h2>
        <p>Encuentra el detalle perfecto para esa persona especial.</p>
        <a asp-controller="Productos" asp-action="Catalogo" class="btn btn-flor">VER CATALOGO</a>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="container footer-top row">

            <div class="footer-brand">
                <a asp-controller="Producto" asp-action="Index" class="footer-logo">
                 🌸FloristeriaBloom
                </a>
                <p class="footer-slogan">Flores frescas a domicilio</p>
            </div>

            <div class="footer-col">
                <h4>La Empresa</h4>
                <a href="#">Blog de FloristeriaBloom</a>
                <a href="#">Contacto</a>
                <a href="#">Nosotros</a>
                <a href="#">Ocasiones especiales</a>
            </div>

            <div class="footer-col">
                <h4>Mi Cuenta</h4>
                <a href="#">Mi perfil</a>
                <a href="#">Mis pedidos</a>
                <a href="#">Preguntas frecuentes</a>
            </div>

            <div class="footer-col">
                <h4>Legales</h4>
                <a href="#">Políticas de despacho</a>
                <a href="#">Política de privacidad</a>
                <a href="#">Términos y condiciones</a>
                <a href="#">Libro de reclamaciones</a>
            </div>

            <div class="footer-col">
                <h4>Contáctanos</h4>
                <p><i class="fa-solid fa-phone"></i> +51 946 984 575</p>
                <div class="footer-social">
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>

        </div>

        <div class="footer-bottom">
            <p>© 2026 FloristeriaBloom. Todos los derechos reservados.</p>
        </div>
    </footer>

    <!-- Bootstrap JS (para eventuales componentes: modales, dropdowns, collapse del menú móvil) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

</body>
</html>
