@model front_FloristeriaBloom.Models.ProductoViewModel
@{
    Layout = null;
    ViewData["Title"] = "Editar producto";
    var categorias = (List<front_FloristeriaBloom.Models.CategoriaViewModel>)ViewBag.Categorias;
    var proveedores = (List<front_FloristeriaBloom.Models.ProveedorViewModel>)ViewBag.Proveedores;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

    <!-- HEADER -->
    <header class="site-header">
        <div class="header-top d-flex align-items-center justify-content-between">
            <a asp-controller="Productos" asp-action="Index" class="logo">🌸 FloristeriaBloom</a>
            <nav class="main-nav d-none d-md-flex">
                <a asp-controller="Productos" asp-action="Catalogo">Ver tienda</a>
                <a asp-controller="Admin" asp-action="Index">Productos</a>
                <a asp-controller="AdminAdicionales" asp-action="Index">Adicionales</a>
                <a asp-controller="AdminPedidos" asp-action="Index">Pedidos</a>
            </nav>
            <div class="header-icons">
                <a asp-controller="AdminPedidos" asp-action="Index" class="notif-bell" id="notifBell" title="Pedidos pendientes">
                    <i class="fa-solid fa-bell"></i>
                    <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                </a>
            </div>
        </div>
    </header>

    <section class="auth-section">
        <div class="container">
            <div class="auth-card admin-card mx-auto">
                <p class="hero-small">PANEL DE ADMINISTRACIÓN</p>
                <h2><i class="fa-solid fa-pen"></i> Editar producto</h2>

                <div asp-validation-summary="All" class="text-danger"></div>

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="ImagenUrl" />

                    <div class="auth-field">
                        <label class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-control" required />
                    </div>
                    <div class="auth-field">
                        <label class="form-label">Descripción</label>
                        <input asp-for="Descripcion" class="form-control" />
                    </div>

                    <div class="row admin-row">
                        <div class="col-md-6 auth-field">
                            <label class="form-label">Precio (S/)</label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-6 auth-field">
                            <label class="form-label">Stock</label>
                            <input asp-for="Stock" type="number" class="form-control" required />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label class="form-label">Color</label>
                        <select asp-for="Color" class="form-control">
                            <option value="">-- Selecciona --</option>
                            <option value="Blanco" selected="@(Model.Color == "Blanco")">Blanco</option>
                            <option value="Rojo" selected="@(Model.Color == "Rojo")">Rojo</option>
                            <option value="Rosado" selected="@(Model.Color == "Rosado")">Rosado</option>
                            <option value="Azul" selected="@(Model.Color == "Azul")">Azul</option>
                            <option value="Multicolor" selected="@(Model.Color == "Multicolor")">Multicolor</option>
                        </select>
                    </div>


                    <div class="auth-field">
                        <label class="form-label">Foto del producto (de frente)</label>
                        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImagenUrl" alt="Imagen actual" style="max-width:120px;border-radius:8px;display:block;" />
                            </div>
                        }
                        <input type="file" name="Imagen" accept="image/*" class="form-control" />
                        <small class="text-muted">Sube una foto nueva solo si quieres reemplazar la actual.</small>
                    </div>

                    <div class="row admin-row">
                        <div class="col-md-6 auth-field">
                            <label class="form-label">Categoría</label>
                            <select asp-for="CategoriaId" class="form-control" required>
                                <option value="">-- Selecciona --</option>
                                @foreach (var c in categorias)
                                {
                                    <option value="@c.Id" selected="@(c.Id == Model.CategoriaId)">@c.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 auth-field">
                            <label class="form-label">Proveedor</label>
                            <select asp-for="ProveedorId" class="form-control" required>
                                <option value="">-- Selecciona --</option>
                                @foreach (var p in proveedores)
                                {
                                    <option value="@p.Id" selected="@(p.Id == Model.ProveedorId)">@p.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-flor w-100">Actualizar producto</button>
                </form>

                <p class="auth-footer">
                    <a asp-action="Index">← Volver al panel</a>
                </p>
            </div>
        </div>
    </section>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script>
            const notifBadge = document.getElementById('notifBadge');
            const notifBell = document.getElementById('notifBell');
            let ultimoConteo = null;

            async function actualizarNotificaciones() {
                try {
                    const resp = await fetch('/AdminPedidos/PendientesCount');
                    const data = await resp.json();

                    if (data.count > 0) {
                        notifBadge.textContent = data.count;
                        notifBadge.style.display = 'flex';
                    } else {
                        notifBadge.style.display = 'none';
                    }

                    if (ultimoConteo !== null && data.count > ultimoConteo) {
                        notifBell.classList.add('pulse');
                        setTimeout(() => notifBell.classList.remove('pulse'), 1200);
                    }
                    ultimoConteo = data.count;
                } catch (e) {
                    console.error('No se pudo actualizar notificaciones', e);
                }
            }

            actualizarNotificaciones();
            setInterval(actualizarNotificaciones, 15000);
    </script>
</body>
</html>
