@model front_FloristeriaBloom.Models.ProductoViewModel
@{
    Layout = null;
    ViewData["Title"] = "Nuevo producto";
    var categorias = (List<front_FloristeriaBloom.Models.CategoriaViewModel>)ViewBag.Categorias;
    var proveedores = (List<front_FloristeriaBloom.Models.ProveedorViewModel>)ViewBag.Proveedores;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

    <!-- HEADER -->
    <header class="site-header">
        <div class="header-top d-flex align-items-center justify-content-between">
            <a asp-controller="Productos" asp-action="Index" class="logo">🌸 FloristeriaBloom</a>
            <nav class="main-nav d-none d-md-flex">
                <a asp-controller="Productos" asp-action="Catalogo">Ver tienda</a>
                <a asp-controller="Admin" asp-action="Index">Productos</a>
                <a asp-controller="AdminAdicionales" asp-action="Index">Adicionales</a>
                <a asp-controller="AdminPedidos" asp-action="Index">Pedidos</a>
            </nav>
            <div class="header-icons">
                <a asp-controller="AdminPedidos" asp-action="Index" class="notif-bell" id="notifBell" title="Pedidos pendientes">
                    <i class="fa-solid fa-bell"></i>
                    <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                </a>
            </div>
        </div>
    </header>

    <section class="auth-section">
        <div class="container">
            <div class="auth-card admin-card mx-auto">
                <p class="hero-small">PANEL DE ADMINISTRACIÓN</p>
                <h2><i class="fa-solid fa-seedling"></i> Nuevo producto</h2>

                <div asp-validation-summary="All" class="text-danger"></div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div class="auth-field">
                        <label class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-control" required />
                    </div>
                    <div class="auth-field">
                        <label class="form-label">Descripción</label>
                        <input asp-for="Descripcion" class="form-control" />
                    </div>

                    <div class="row admin-row">
                        <div class="col-md-6 auth-field">
                            <label class="form-label">Precio (S/)</label>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-6 auth-field">
                            <label class="form-label">Stock</label>
                            <input asp-for="Stock" type="number" class="form-control" required />
                        </div>
                    </div>

                    <div class="auth-field">
                        <label class="form-label">Color</label>
                        <select asp-for="Color" class="form-control">
                            <option value="">-- Selecciona --</option>
                            <option value="Blanco">Blanco</option>
                            <option value="Rojo">Rojo</option>
                            <option value="Rosado">Rosado</option>
                            <option value="Azul">Azul</option>
                            <option value="Multicolor">Multicolor</option>
                        </select>
                    </div>

                    <!-- SUBIDA DE IMAGEN CON VISTA PREVIA -->
                    <div class="auth-field">
                        <label class="form-label">Foto del producto (de frente)</label>
                        <label for="inputImagen" class="image-dropzone" id="dropzone">
                            <div id="dropzoneContent" class="dropzone-content">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <p><strong>Haz clic para elegir una foto</strong> o arrástrala aquí</p>
                                <span class="dropzone-hint">JPG, PNG o WEBP</span>
                            </div>
                            <img id="previewImg" class="dropzone-preview" style="display:none;" />
                        </label>
                        <input type="file" id="inputImagen" name="Imagen" accept="image/*" class="d-none" required />
                    </div>

                    <div class="row admin-row">
                        <div class="col-md-6 auth-field">
                            <label class="form-label">Categoría</label>
                            <select asp-for="CategoriaId" class="form-control" required>
                                <option value="">-- Selecciona --</option>
                                @foreach (var c in categorias)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 auth-field">
                            <label class="form-label">Proveedor</label>
                            <select asp-for="ProveedorId" class="form-control" required>
                                <option value="">-- Selecciona --</option>
                                @foreach (var p in proveedores)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-flor w-100">Guardar producto</button>
                </form>

                <p class="auth-footer">
                    <a asp-action="Index">← Volver al panel</a>
                </p>
            </div>
        </div>
    </section>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script>
            const inputImagen = document.getElementById('inputImagen');
            const dropzone = document.getElementById('dropzone');
            const dropzoneContent = document.getElementById('dropzoneContent');
            const previewImg = document.getElementById('previewImg');

            function mostrarPreview(file) {
                if (!file) return;
                const reader = new FileReader();
                reader.onload = e => {
                    previewImg.src = e.target.result;
                    previewImg.style.display = 'block';
                    dropzoneContent.style.display = 'none';
                    dropzone.classList.add('has-image');
                };
                reader.readAsDataURL(file);
            }

            inputImagen.addEventListener('change', () => {
                if (inputImagen.files && inputImagen.files[0]) {
                    mostrarPreview(inputImagen.files[0]);
                }
            });

            dropzone.addEventListener('dragover', e => {
                e.preventDefault();
                dropzone.classList.add('dragging');
            });
            dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragging'));
            dropzone.addEventListener('drop', e => {
                e.preventDefault();
                dropzone.classList.remove('dragging');
                if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                    inputImagen.files = e.dataTransfer.files;
                    mostrarPreview(e.dataTransfer.files[0]);
                }
            });
    </script>
</body>
</html>