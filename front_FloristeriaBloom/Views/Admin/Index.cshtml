@model List<front_FloristeriaBloom.Models.ProductoViewModel>
@{
    Layout = null;
    ViewData["Title"] = "Panel Admin";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>

    <!-- HEADER -->
    <header class="site-header">
        <div class="header-top d-flex align-items-center justify-content-between">
            <a asp-controller="Productos" asp-action="Index" class="logo">
                🌸 FloristeriaBloom
            </a>
            <nav class="main-nav d-none d-md-flex">
                <a asp-controller="Productos" asp-action="Catalogo">Ver tienda</a>
                <a asp-controller="Admin" asp-action="Index">Panel Admin</a>
                <a asp-controller="AdminAdicionales" asp-action="Index">Adicionales</a>
                <a asp-controller="AdminPedidos" asp-action="Index">Pedidos</a>
            </nav>
            <div class="header-icons">
                <a asp-controller="AdminPedidos" asp-action="Index" class="notif-bell" id="notifBell" title="Pedidos pendientes">
                    <i class="fa-solid fa-bell"></i>
                    <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
                </a>
            </div>
        </div>
    </header>

    <section class="admin-panel">
        <div class="container">
            <div class="admin-panel-header d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <p class="hero-small">PANEL DE ADMINISTRACIÓN</p>
                    <h2><i class="fa-solid fa-gear"></i> Gestión de Productos</h2>
                </div>
                <a asp-action="Create" class="btn btn-flor">
                    <i class="fa-solid fa-plus"></i> Nuevo producto
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="cart-empty text-center">
                    <p>Todavía no has agregado ningún producto.</p>
                    <a asp-action="Create" class="btn btn-flor">Agregar el primero</a>
                </div>
            }
            else
            {
                <div class="admin-table-wrapper table-responsive">
                    <table class="table cart-table align-middle">
                        <thead>
                            <tr>
                                <th>Imagen</th>
                                <th>Nombre</th>
                                <th>Precio</th>
                                <th>Stock</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(p.ImagenUrl) ? "/imagenes/rosas-rojas.jpg" : p.ImagenUrl)"
                                             alt="@p.Nombre"
                                             style="width:56px;height:56px;object-fit:cover;border-radius:6px;" />
                                    </td>
                                    <td>@p.Nombre</td>
                                    <td>S/ @p.Precio</td>
                                    <td>
                                        @p.Stock
                                        @if (p.Stock <= 5)
                                        {
                                            <span class="discount" style="position:static;display:inline-block;font-size:10px;margin-left:6px;">bajo</span>
                                        }
                                    </td>
                                    <td class="admin-actions">
                                        <a asp-action="Edit" asp-route-id="@p.Id" title="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@p.Id" title="Eliminar"
                                           onclick="return confirm('¿Eliminar este producto?')">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script>
            const notifBadge = document.getElementById('notifBadge');
            const notifBell = document.getElementById('notifBell');
            let ultimoConteo = null;

            async function actualizarNotificaciones() {
                try {
                    const resp = await fetch('/AdminPedidos/PendientesCount');
                    const data = await resp.json();

                    if (data.count > 0) {
                        notifBadge.textContent = data.count;
                        notifBadge.style.display = 'flex';
                    } else {
                        notifBadge.style.display = 'none';
                    }

                    if (ultimoConteo !== null && data.count > ultimoConteo) {
                        notifBell.classList.add('pulse');
                        setTimeout(() => notifBell.classList.remove('pulse'), 1200);
                    }
                    ultimoConteo = data.count;
                } catch (e) {
                    console.error('No se pudo actualizar notificaciones', e);
                }
            }

            actualizarNotificaciones();
            setInterval(actualizarNotificaciones, 15000); // cada 15 segundos
    </script>
</body>
</html>
